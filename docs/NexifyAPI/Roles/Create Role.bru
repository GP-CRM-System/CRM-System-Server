meta {
  name: Create Role
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/api/v1/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "root",
    "permissions": [
      {
        "permName": "Company",
        "read": true,
        "write": true
      },
      {
        "permName": "Contact",
        "read": true,
        "write": true
      },
      {
        "permName": "Employee",
        "read": true,
        "write": true
      },
      {
        "permName": "Order",
        "read": true,
        "write": true
      },
      {
        "permName": "Ticket",
        "read": true,
        "write": true
      },
      {
        "permName": "Deal",
        "read": true,
        "write": true
      },
      {
        "permName": "Role",
        "read": true,
        "write": true
      }
    ]
  }
}

settings {
  encodeUrl: true
}
