    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "165ca738-b5c6-404d-8857-17c84f331ccf",
                "exec": [
                  "let adminId;",
                  "try {",
                  "    const jsonData = pm.response.json();",
                  "    adminId = jsonData?.data?.admin?._id;",
                  "    if (adminId) {",
                  "        pm.collectionVariables.set('adminId', adminId);",
                  "        pm.test('adminId set as collection variable', function () {",
                  "            pm.expect(pm.collectionVariables.get('adminId')).to.eql(adminId);",
                  "        });",
                  "    } else {",
                  "        pm.test(\"adminId not found in response\", function () {",
                  "            pm.expect(adminId, \"adminId should be present in response.data.admin._id\").to.not.be.undefined;",
                  "        });",
                  "    }",
                  "} catch (e) {",
                  "    pm.test(\"Response is not valid JSON or does not contain expected structure\", function () {",
                  "        pm.expect.fail(\"Could not extract adminId: \" + e.message);",
                  "    });",
                  "}",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "id": "f1f770be-5817-44ef-a344-c18beaf83bba",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\":\"FirstName Lastname\",\n  \"phone\":\"1234567890\",\n  \"email\":\"{{adminEmail}}\",\n  \"password\":\"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
