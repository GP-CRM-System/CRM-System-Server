    "type": "git",
    "url": "git+https://github.com/GP-CRM-System/CRM-System-Server.git"
  },
  "license": "MIT",
  "author": "GP-CRM-System",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "dev:start": "tsx src/app.ts",
    "dev:watch": "tsx watch src/app.ts",
    "dev:build": "tsc",
    "dev:lint": "eslint src --ext .ts",
    "dev:format": "prettier --write src/**/*.{js,ts}",
