{
  "openapi": "3.1.1",
  "info": {
    "title": "Nexify API - CRM System",
    "description": "API documentation for the CRM System",
    "version": "1.0.0",
    "contact": {
      "email": "seifusama@gmail.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/license/mit/"
    }
  },
  "servers": [
    {
      "url": "http://{basePath}:{port}/api/v1",
      "description": "Local development server",
      "variables": {
        "basePath": {
          "default": "localhost"
        },
        "port": {
          "default": "4650"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token"
      }
    },
    "schemas": {
      "Company": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "owner": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "website": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "industry": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["Prospect", "Partner", "Reseller", "Vendor", "Other"]
          },
          "address": { "type": "string" },
          "numberOfEmployees": { "type": "number" },
          "isActive": { "type": "boolean" }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "address": { "type": "string" },
          "jobTitle": { "type": "string" },
          "owner": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "stage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "enum": ["Lead", "Customer"] },
                "date": { "type": "string", "format": "date-time" }
              }
            }
          },
          "isActive": { "type": "boolean" }
        }
      },
      "Deal": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "stage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "Appointment Scheduled",
                    "Qualified To Buy",
                    "Presentation Scheduled",
                    "Decision Maker Bought-In",
                    "Contract Sent",
                    "Closed Won",
                    "Closed Lost"
                  ]
                },
                "date": { "type": "string", "format": "date-time" }
              }
            }
          },
          "amount": { "type": "number" },
          "owner": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "contact": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "company": { "type": "string", "example": "507f1f77bcf86cd799439011" }
        }
      },
      "Employee": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "salary": { "type": "number" },
          "isActive": { "type": "boolean" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "price": { "type": "number" },
          "owner": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "stage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stageType": {
                  "type": "string",
                  "enum": [
                    "Open",
                    "Processed",
                    "Shipped",
                    "Delivered",
                    "Cancelled"
                  ]
                },
                "date": { "type": "string", "format": "date-time" }
              }
            }
          },
          "contact": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "employee": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "isActive": { "type": "boolean" },
          "Company": { "$ref": "#/components/schemas/Permission" },
          "Employee": { "$ref": "#/components/schemas/Permission" },
          "Contact": { "$ref": "#/components/schemas/Permission" },
          "Deal": { "$ref": "#/components/schemas/Permission" },
          "Role": { "$ref": "#/components/schemas/Permission" },
          "Order": { "$ref": "#/components/schemas/Permission" },
          "Ticket": { "$ref": "#/components/schemas/Permission" }
        }
      },
      "Permission": {
        "type": "object",
        "properties": {
          "read": { "type": "boolean" },
          "write": { "type": "boolean" },
          "delete": { "type": "boolean" }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "status": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statusType": {
                  "type": "string",
                  "enum": [
                    "New",
                    "Waiting on Contact",
                    "Waiting on Employee",
                    "Closed"
                  ]
                },
                "date": { "type": "string", "format": "date-time" }
              }
            }
          },
          "description": { "type": "string" },
          "owner": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "source": {
            "type": "string",
            "enum": ["Chat", "Email", "Phone", "Form"]
          },
          "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "contact": { "type": "string", "example": "507f1f77bcf86cd799439011" }
        }
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        },
        "required": ["email", "password"]
      },
      "Register": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" },
          "companyName": { "type": "string" },
          "numberOfEmployees": { "type": "number" },
          "industry": { "type": "string" },
          "companyPhone": { "type": "string" }
        },
        "required": ["fullName", "email", "password", "companyName"]
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new admin",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Register" }
            }
          }
        },
        "responses": {
          "201": { "description": "Admin created" },
          "400": { "description": "Invalid payload" },
          "409": { "description": "Email already exists" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Login" }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in successfully" },
          "400": { "description": "Invalid payload" },
          "401": { "description": "Invalid credentials" },
          "404": { "description": "Employee not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/auth/google": {
      "get": {
        "summary": "Initiate Google Login",
        "tags": ["Auth"],
        "responses": {
          "302": { "description": "Redirect to Google" }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "summary": "Google Login Callback",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Logged in successfully" },
          "401": { "description": "Authentication failed" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Request Password Reset",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Reset email sent if user exists" },
          "400": { "description": "Invalid email" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/auth/reset-password/{id}": {
      "post": {
        "summary": "Reset Password",
        "tags": ["Auth"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": { "type": "string" }
                },
                "required": ["password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password reset successfully" },
          "400": { "description": "Invalid password or expired token" },
          "404": { "description": "Employee not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "summary": "Logout",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Logged out successfully" },
          "500": { "description": "Server error" }
        }
      }
    },
