          "event": [
            {
              "listen": "test",
              "script": {
                "id": "c50bfb17-ba35-42c7-8840-f15452cbc8fb",
                "exec": [
                  "// Visualization Script",
                  "// Visualization Script",
                  "const template = `",
                  "<canvas id=\"dealsChart\" height=\"75\"></canvas>",
                  "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js\"></script>",
                  "<script>",
                  "    var ctx = document.getElementById(\"dealsChart\");",
                  "    var myChart = new Chart(ctx, {",
                  "        type: \"bar\",",
                  "        data: {",
                  "            labels: [],",
                  "            datasets: [{",
                  "                label: 'Deal Amount',",
                  "                backgroundColor: 'rgba(54, 162, 235, 0.5)',",
                  "                borderColor: 'rgba(54, 162, 235, 1)',",
                  "                borderWidth: 1,",
                  "                data: []",
                  "            }]",
                  "        },",
                  "        options: {",
                  "            legend: { display: true },",
                  "            title: {",
                  "                display: true,",
                  "                text: 'Deals Overview'",
                  "            },",
                  "            scales: {",
                  "                xAxes: [{",
                  "                    display: true,",
                  "                    scaleLabel: {",
                  "                        display: true,",
                  "                        labelString: 'Deal Name'",
                  "                    }",
                  "                }],",
                  "                yAxes: [{",
                  "                    display: true,",
                  "                    scaleLabel: {",
                  "                        display: true,",
                  "                        labelString: 'Amount'",
                  "                    }",
                  "                }]",
                  "            }",
                  "        }",
                  "    });",
                  "",
                  "    pm.getData(function (err, value) {",
                  "        myChart.data.labels = value.dealNames;",
                  "        myChart.data.datasets[0].data = value.dealAmounts;",
                  "        myChart.update();",
                  "    });",
                  "</script>`;",
                  "",
                  "function createPayload() {",
                  "    let data = pm.response.json();",
                  "    let deals = Array.isArray(data) ? data : (data.deals || []);",
                  "    let dealNames = deals.map(d => d.name || d.title || d.id || 'N/A');",
                  "    let dealAmounts = deals.map(d => d.amount || d.value || 0);",
                  "    return { dealNames, dealAmounts };",
                  "}",
                  "pm.visualizer.set(template, createPayload());"
                ],
                "type": "text/javascript"
              }
            },
