meta {
  name: Register Admin
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "fullName":"FirstName Lastname",
    "phone":"1234567890",
    "email":"email@gmail.com",
    "password":"pass1234"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
