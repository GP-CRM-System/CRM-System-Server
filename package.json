{
  "name": "crm-system-server",
  "version": "1.0.0",
  "description": "Backend Repo for Nexify CRM System",
  "homepage": "https://github.com/GP-CRM-System/CRM-System-Server#readme",
  "bugs": {
    "url": "https://github.com/GP-CRM-System/CRM-System-Server/issues"
  },
