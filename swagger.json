  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ResponseMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "data": {
            "type": "object",
            "nullable": true,
            "example": {
              "name": "John Doe",
              "email": "gkx5f@example.com"
            }
          },
          "error": {
            "type": "string",
            "nullable": true,
            "example": "Resource not found"
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "64a7f0c2e4b0c8b1a2d3e4f5"
          },
          "name": {
            "type": "string",
            "example": "Root"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": {
              "permName": "Order",
              "read": true,
              "write": true
            }
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "64a7f0c2e4b0c8b1a2d3e4f5"
          },
          "fullName": {
            "type": "string",
            "example": "John Doe"
          },
          "phone": {
            "type": "string",
            "example": "+1234567890"
          },
          "email": {
            "type": "string",
            "example": "gkx5f@example.com"
          },
          "password": {
            "type": "string",
            "example": "12345678"
          },
          "roleId": {
            "type": "string",
            "example": "64a7f0c2e4b0c8b1a2d3e4f5"
          },
          "salary": {
            "type": "number",
            "example": 5000
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "64a7f0c2e4b0c8b1a2d3e4f5"
          },
          "name": {
            "type": "string",
            "example": "Jane Smith"
          },
          "email": {
            "type": "string",
            "example": "gkx5f@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+1234567890"
          },
          "address": {
            "type": "string",
            "example": "123 Main Street"
          },
          "jobTitle": {
            "type": "string",
            "example": "Software Engineer"
          },
          "ownerId": {
            "type": "string",
            "example": "64a7f0c2e4b0c8b1a2d3e4f5"
          },
          "stage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Lead"
                },
                "date": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2024-07-01T12:00:00Z"
                }
              }
            },
            "example": [
              {
                "name": "Lead",
                "date": "2024-07-01T12:00:00Z"
              },
              {
                "name": "Customer",
                "date": "2024-07-05T15:30:00Z"
              }
            ]
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        }
      }
    }
  }
